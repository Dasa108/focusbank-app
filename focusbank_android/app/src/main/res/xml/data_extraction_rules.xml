<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="focusbank.db" />
        <exclude domain="database" path="focusbank.db-wal" />
        <exclude domain="database" path="focusbank.db-shm" />
        <exclude domain="database" path="focusbank.db-journal" />
        <exclude domain="sharedpref" path="focusbank.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="focusbank.db" />
        <exclude domain="database" path="focusbank.db-wal" />
        <exclude domain="database" path="focusbank.db-shm" />
        <exclude domain="database" path="focusbank.db-journal" />
        <exclude domain="sharedpref" path="focusbank.xml" />
    </device-transfer>
</data-extraction-rules>
