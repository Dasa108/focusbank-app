# Copy to keystore.properties (same folder) and fill in. keystore.properties and *.jks are
# git-ignored: never commit them. Keep a backup of the keystore and passwords somewhere safe;
# with Play App Signing a lost upload key can be reset, but only through Play support.
#
# Create the upload key once (run from focusbank_android/, choose your own passwords):
#   keytool -genkeypair -v -keystore ../../focusbank-upload.jks -alias focusbank-upload \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to focusbank_android/ (absolute paths also work). Keeping the
# .jks outside the repository folder is safest.
storeFile=../../focusbank-upload.jks
storePassword=
keyAlias=focusbank-upload
keyPassword=

# The same values can come from environment variables instead (useful for CI):
#   FOCUSBANK_KEYSTORE_FILE, FOCUSBANK_KEYSTORE_PASSWORD, FOCUSBANK_KEY_ALIAS, FOCUSBANK_KEY_PASSWORD
